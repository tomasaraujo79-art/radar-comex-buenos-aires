# Copy this file to .env and fill only the integrations you want to use.

MAX_TRAVEL_MINUTES=60
REFERENCE_LOCATION=Belgrano, CABA, Argentina
MIN_SCORE=55
TIMEZONE=America/Argentina/Buenos_Aires
DAILY_RUN_TIME=09:00

# Optional. OpenRouteService has a free tier and improves drive-time estimates.
# https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# Optional notifications.
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

